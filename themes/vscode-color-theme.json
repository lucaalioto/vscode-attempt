{
  "name": "Luca Themed",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // --- MAIN EDITOR COLORS ---
    "editor.background": "#1E1E1E",
    "editor.foreground": "#dedede", 

    // --- TOP BAR (TITLE BAR) ---
    "titleBar.activeBackground": "#1f1f1f",
    "titleBar.activeForeground": "#dedede",
    "titleBar.inactiveBackground": "#1f1f1f",

    // --- TABS ---
    "editorGroupHeader.tabsBackground": "#282828",
    "tab.activeBackground": "#353535",
    "tab.inactiveBackground": "#282828",

    // --- CURSOR & SELECTION ---
    "editorCursor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#4E535C",
    "editor.inactiveSelectionBackground": "#4E535C",
    "editor.selectionHighlightBackground": "#4E535C",

    // --- LINE HIGHLIGHTING & NUMBERS ---
    "editor.lineHighlightBackground": "#00000000", // Invisible background
    "editorLineNumber.foreground": "#666E76",
    "editorLineNumber.activeForeground": "#A9E1FB",
    "editorGutter.background": "#232525",

    

    // --- WHITESPACE & GUIDES ---
    "editorWhitespace.foreground": "#4B4E55",
    "editorIndentGuide.background1": "#393939",
    "editorIndentGuide.activeBackground1": "#666E76",
    
    // --- BRACKETS ---
    "editorBracketMatch.border": "#4B4E55",
    "editorBracketHighlight.foreground1": "#D7D7D7",
    "editorBracketHighlight.foreground2": "#D7D7D7",
    "editorBracketHighlight.foreground3": "#D7D7D7",
  
    // --- ERRORS & WARNINGS ---
    "editorError.foreground": "#DF5F5F",

    // --- TERMINAL & SIDEBAR ---
    "terminal.background": "#1D1F21",
    "terminal.foreground": "#C5C8C6",

    // --- SIDE BAR (File Explorer) ---
    "sideBar.background": "#1f1f1f",              // Darker background (Matches Title Bar)
    "sideBar.foreground": "#dedede",              // File names
    
    // --- ACTIVITY BAR (The narrow icon strip on far left) ---
    "activityBar.background": "#1f1f1f",          // Matches Side Bar & Title Bar
    "activityBar.foreground": "#FFFFFF",          // Active Icon color (White)
    "activityBar.inactiveForeground": "#4E535C",  // Inactive Icon color (Grey)
    "activityBar.border": "#1f1f1f",              // Removes the line between Activity & Side bar

    // --- STATUS BAR (The bottom strip) ---
    "statusBar.background": "#1f1f1f",        // Dark Grey (Matches your Title/Side Bar)
    "statusBar.foreground": "#dedede",        // Text color
    "statusBar.border": "#282A2E"            // Thin border on top (optional)
  },
  "tokenColors": [
    {
        "name": "Code Chunks (R, Python, etc)",
        "scope": [
            "source", 
            "source.r", 
            "source.python", 
            "markup.raw.block",
            "variable", 
            "meta.function-call",
            "meta.embedded.block.r"
        ],
        "settings": {
            "foreground": "#9CDCFE"
        }
    },
    {
      "name": "Markdown Text (Explicitly Grey)",
      "scope": ["text.html.markdown", "meta.paragraph"],
      "settings": {
        "foreground": "#dedede"
      }
    },
    {
      "name": "Markdown Headings (##)",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#dedede", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold (**)",
      "scope": ["markup.bold", "punctuation.definition.bold.markdown"], 
      "settings": { "foreground": "#dedede", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic (*)",
      "scope": ["markup.italic", "punctuation.definition.italic.markdown"],
      "settings": { "foreground": "#dedede", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Lists",
      "scope": ["markup.list", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#B1CFA3" }
    },
    {
      "name": "Markdown Blockquotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#6B9258", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Links",
      "scope": ["string.other.link.title.markdown"],
      "settings": { "foreground": "#A9E1FB", "fontStyle": "underline" }
    },
{
      "name": "Quarto Citations (@reference)",
      "scope": [
        "keyword.control.import.reference"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
  {
      "name": "LaTeX Commands (Broader Fix)",
      "scope": [
        "keyword.control.latex",
        "keyword.control.tex",
        "support.function.general.tex",
        "support.function.latex",
        // These two lines catch LaTeX inside RMarkdown/Quarto usually
        "constant.character.escape", 
        "punctuation.definition.keyword.tex",
        "punctuation.definition.backslash"
      ],
      "settings": {
        "foreground": "#c681dd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LaTeX Math Mode ($...$)",
      "scope": [
        "string.other.math.tex",
        "punctuation.definition.string.begin.tex",
        "punctuation.definition.string.end.tex"
      ],
      "settings": {
        "foreground": "#DCDC9E"
      }
    },

    {
      "name": "JSON with Comments (Keys/Strings)",
      "scope": [
          "support.type.property-name.json.comments",
          "string.json.comments",
          "meta.structure.dictionary.json.comments",
          "meta.structure.array.json.comments",
          "meta.structure.dictionary.value.json.comments",
          "source.json.comments"
      ],
      "settings": {
          "foreground": "#A9E1FB" 
      }
   },

    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6B9258", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#CE9178" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage", "meta.keyword"],
      "settings": { "foreground": "#CE9178" }
    },
    {
      "name": "Operators / Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation", 
        "punctuation.terminator", 
        "punctuation.separator",
        "meta.brace"
      ],
      "settings": { "foreground": "#D7D7D7" }
    },
    {
      "name": "Numbers / Constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#B1CFA3" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "keyword.other"],
      "settings": { "foreground": "#c681dd" }
    },
    {
      "name": "Tags / Attributes",
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": { "foreground": "#CC6666" }
    }
  ]
}